# Copy to .env and set a unique password (at least 12 characters).
ADMIN_PASSWORD=
PORT=8080
BIND_ADDRESS=127.0.0.1
MUSIC_PATH=./music
DOWNLOAD_PARALLELISM=2
TZ=Asia/Shanghai
# 被替换文件的回收站。留空表示 <MUSIC_PATH>/.trash（与音乐目录同一文件系统，移动是原子的）。
# 指向音乐目录之外时，需要在 compose 中额外挂载该目录，否则会落进容器可写层并在重建时丢失。
ARCHIVE_TRASH=
# 回收站保留天数。0 表示不保留（被替换的文件直接删除，即旧行为）。
SUPERSEDED_RETENTION_DAYS=7
# Set true when accessing through HTTPS.
COOKIE_SECURE=false
